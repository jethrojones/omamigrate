        args = ap.parse_args(["gui"])

    if args.cmd == "gui":
        return cmd_gui(args)
    if args.cmd == "scan":
        inv = build_inventory()
        if args.json or args.events:
            print(json.dumps(inv, indent=2))
        else:
            print(f"Omamigrate — inventory for {inv['host']} "
                  f"(omarchy {inv['omarchy'] or 'n/a'})\n")
            for c in inv["categories"]:
                flag = " (opt-in)" if c["optin"] else ""
                if c["id"] == "packages":
                    print(f"  {c['icon']} {c['label']:<22} "
                          f"{c['meta'].get('count', 0):>9} packages{flag}")
                    continue
                print(f"  {c['icon']} {c['label']:<22} {human(c['bytes']):>9} "
                      f"{c['files']:>6} files{flag}")
                for it in c["items"][:8]:
                    print(f"      - {it['label']}  ({human(it['bytes'])})")
                if len(c["items"]) > 8:
                    print(f"      … and {len(c['items']) - 8} more")
        return 0
    if args.cmd == "pack":
        return cmd_pack(args)
    if args.cmd == "serve":
        return cmd_serve(args)
    if args.cmd == "unpack":
        return cmd_unpack(args)
    if args.cmd == "apply":
        return cmd_apply(args)
    if args.cmd == "verify":
        return cmd_verify(args)
    if args.cmd == "agent":
        return cmd_agent(args)
    if args.cmd == "install-menu":
        return cmd_install_menu(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
