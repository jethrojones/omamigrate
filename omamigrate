def build_inventory():
    cats = []

    def add(cat, items, optin=False, meta=None):
        total_b = sum(i["bytes"] for i in items)
        total_f = sum(i["files"] for i in items)
        cats.append({
            "id": cat["id"], "label": cat["label"], "icon": cat["icon"],
            "desc": cat["desc"], "optin": optin, "items": items,
            "bytes": total_b, "files": total_f, "meta": meta or {},
        })

    def file_item(rel):
        p = HOME / rel
        try:
            st = p.stat()
        except OSError:
            return None
        return {"id": rel, "label": rel.split("/")[-1], "rel": rel,
                "bytes": st.st_size, "files": 1}

    def dir_item(rel, label=None):
        p = HOME / rel
        if not p.exists():
            return None
        f, b = dir_stats(p, rel)
        return {"id": rel, "label": label or rel.split("/")[-1], "rel": rel,
                "bytes": b, "files": f}

    # -- shell -------------------------------------------------------------
    items = []
    for rel in (".config/omarchy/shell.json", ".config/omarchy/shell.toml"):
        it = file_item(rel)
        if it:
            items.append(it)
    for rel in (".config/omarchy/extensions", ".config/omarchy/themed",
                ".config/omarchy/hooks", ".config/omarchy/branding"):
        it = dir_item(rel)
        if it:
            items.append(it)
    om_root = CFG / "omarchy"
    if om_root.is_dir():
        for f in sorted(om_root.iterdir()):
            if f.is_file() and f.suffix == ".json" and f.name not in (
                    "shell.json",):
                it = file_item(f".config/omarchy/{f.name}")
                if it:
                    items.append(it)
    plugins_root = CFG / "omarchy" / "plugins"
    plugin_metas = []
    if plugins_root.is_dir():
        for d in sorted(plugins_root.iterdir()):
            if not d.is_dir():
                continue
            rel = f".config/omarchy/plugins/{d.name}"
            f, b = dir_stats(d, rel)
            remote = git_remote(d)
            items.append({"id": rel, "label": d.name, "rel": rel,
                          "bytes": b, "files": f, "kind": "plugin"})
            plugin_metas.append({"id": d.name, "remote": remote})
    add({"id": "shell", "label": "Omarchy Shell", "icon": "⚡",
         "desc": "Bar layout, widgets, plugins, hooks, menu entries"},
        items, meta={"plugins": plugin_metas})

    # -- hyprland ----------------------------------------------------------
    items = []
    hypr = CFG / "hypr"
    if hypr.is_dir():
        for f in sorted(hypr.rglob("*")):
            if any(part in EXCLUDE_DIRS for part in f.parts):
                continue
            if f.name.endswith(".lock"):
                continue
            if f.is_file():
                it = file_item(f".config/hypr/{f.relative_to(hypr)}")
                if it:
                    items.append(it)
    it = dir_item(".local/state/omarchy/toggles", "toggles")
    if it:
        items.append(it)
    add({"id": "hyprland", "label": "Hyprland", "icon": "🪟",
         "desc": "Keybindings, monitors, input, look & feel, animations"},
        items)

    # -- themes ------------------------------------------------------------
    items = []
    theme_metas = []
    themes_root = CFG / "omarchy" / "themes"
    if themes_root.is_dir():
        for d in sorted(themes_root.iterdir()):
            if not d.is_dir():
                continue
            rel = f".config/omarchy/themes/{d.name}"
            f, b = dir_stats(d, rel)
            remote = git_remote(d)
            items.append({"id": rel, "label": d.name, "rel": rel,
                          "bytes": b, "files": f, "kind": "theme"})
            theme_metas.append({"name": d.name, "remote": remote})
    add({"id": "themes", "label": "Themes & Backgrounds", "icon": "🎨",
         "desc": "Custom themes, git-installed themes, active theme"},
        items,
        meta={"current": current_theme(), "themes": theme_metas})

    # -- terminals -----------------------------------------------------------
    items = []
    for t in ("foot", "alacritty", "kitty", "ghostty"):
        it = dir_item(f".config/{t}", t)
        if it:
            items.append(it)
    add({"id": "terminals", "label": "Terminals", "icon": "🖥️",
         "desc": "Foot, Alacritty, Kitty, Ghostty configurations"}, items)

    # -- dev -----------------------------------------------------------------
    items = []
    specs = [
        (dir_item(".config/nvim", "nvim config"), ),
        (dir_item(".local/share/nvim", "nvim data"), ),
        (dir_item(".config/git", "git"), ),
        (dir_item(".config/lazygit", "lazygit"), ),
        (file_item(".config/starship.toml"), ),
        (dir_item(".config/tmux", "tmux"), ),
        (dir_item(".config/mise", "mise"), ),
        (file_item(".bashrc"), ),
        (file_item(".bash_profile"), ),
        (file_item(".profile"), ),
        (file_item(".XCompose"), ),
    ]
    for (it,) in specs:
        if it:
            items.append(it)
    add({"id": "dev", "label": "Editor & Dev Tools", "icon": "💻",
         "desc": "Neovim, git, lazygit, starship, tmux, mise, shell"}, items)

    # -- packages ------------------------------------------------------------
    pkgs = []
    try:
        out = run(["pacman", "-Qqe"]).stdout
        pkgs = [l for l in out.splitlines() if l.strip()]
    except FileNotFoundError:
        pass
    add({"id": "packages", "label": "Packages", "icon": "📦",
         "desc": "Everything you explicitly installed (pacman -Qqe)"},
        [], meta={"packages": pkgs, "count": len(pkgs)})

    # -- defaults ------------------------------------------------------------
    items = []
    for rel in (".config/xdg-terminals.list", ".config/mimeapps.list"):
        it = file_item(rel)
        if it:
            items.append(it)
    it = dir_item(".config/omarchy/defaults", "omarchy defaults")
    if it:
        items.append(it)
    it = dir_item(".local/state/omarchy/defaults", "state defaults")
    if it:
        items.append(it)
    terminal = None
    term_list = read_state_file(CFG / "xdg-terminals.list")
    if term_list:
        for line in term_list.splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                terminal = desktop_to_name(line)
                break
    browser = None
    mime = read_state_file(CFG / "mimeapps.list")
    if mime:
        for line in mime.splitlines():
            if line.startswith("text/html="):
                browser = desktop_to_name(line.split("=", 1)[1])
                break
    meta = {
        "terminal": terminal or "foot",
        "editor": read_state_file(OMSTATE / "defaults" / "editor") or "nvim",
        "browser": browser or "chromium",
        "agent": default_agent(),
    }
    add({"id": "defaults", "label": "Defaults", "icon": "🎯",
         "desc": "Default terminal, editor, browser, agent"}, items, meta=meta)

    # -- apps ------------------------------------------------------------------
    known_cfg = {"omarchy", "hypr", "foot", "alacritty", "kitty", "ghostty",
                 "nvim", "git", "lazygit", "tmux", "mise", "starship.toml"}
    items = []
    if CFG.is_dir():
        for e in sorted(CFG.iterdir()):
            if e.name in known_cfg:
                continue
            if e.name.startswith(".") and e.name not in (".",):
                continue
            it = dir_item(f".config/{e.name}") if e.is_dir() \
                else file_item(f".config/{e.name}")
            if it:
                items.append(it)
    add({"id": "apps", "label": "Other App Configs", "icon": "🧩",
         "desc": "Every other config under ~/.config (browsers, TUIs, AI agents…)"},
        items)

    # -- share -------------------------------------------------------------------
    known_share = {"nvim", "mise", "Trash", "pki", "keyrings", "caches",
                   "gvfs-metadata", "Trash-1000"}
    items = []
    if SHARE.is_dir():
        for e in sorted(SHARE.iterdir()):
            if e.name in known_share or e.name.startswith("."):
                continue
            it = dir_item(f".local/share/{e.name}") if e.is_dir() \
                else file_item(f".local/share/{e.name}")
            if it:
                items.append(it)
    add({"id": "share", "label": "Local Share Data", "icon": "📁",
         "desc": "Desktop entries, icons, zoxide, app data under ~/.local/share"},
        items)

    # -- secrets -------------------------------------------------------------------
    items = []
    for rel, label in ((".ssh", "SSH keys"), (".gnupg", "GPG keys"),
                       (".netrc", ".netrc"),
                       (".local/share/keyrings", "keyrings")):
        it = dir_item(rel, label) if (HOME / rel).is_dir() \
            else file_item(rel, )
        if it:
            it["label"] = label
            items.append(it)
    add({"id": "secrets", "label": "Secrets & Keys", "icon": "🔐",
         "desc": "SSH, GPG, keyrings — only if you tick this"}, items,
        optin=True)

    # -- data (case-insensitive so ~/projects matches 'Projects') ------------
    items = []
    for d in ("Documents", "Downloads", "Projects", "Work", "Music",
              "Pictures", "Videos", "Games"):
        rel = home_dir_rel(d)
        if not rel:
            continue
        it = dir_item(rel, d)
        if it and it["files"]:
            items.append(it)
    add({"id": "data", "label": "Personal Files", "icon": "📚",
         "desc": "Documents, projects, media — tick this to bring them over"},
        items, optin=True)

    return {
        "host": socket.gethostname(),
        "user": os.environ.get("USER", "user"),
        "omarchy": omarchy_version(),
        "channel": omarchy_channel(),
        "categories": cats,
    }


def carbon_items(inv):
    """Everything on this box. A carbon copy means *everything* — including
    the opt-in sensitive items — because the user deliberately chose it."""
    ids = []
    for cat in inv["categories"]:
        for it in cat["items"]:
            ids.append(it["id"])
    return ids


def category_ids(inv):
    return {c["id"] for c in inv["categories"]}


def expand_categories(inv, cats):
    """Expand category ids into item ids (bundleable rels)."""
    wanted = set(cats)
    return [it["id"] for c in inv["categories"] if c["id"] in wanted
            for it in c["items"]]


def resolve_selection(inv, select=None, exclude=None):
    """select: item rels (or None). Returns item ids to pack."""
    exclude = set(exclude or [])
    if not select:
        return []
    wanted = set(select)
    return sorted({it["id"] for c in inv["categories"] for it in c["items"]
                   if it["id"] in wanted and it["id"] not in exclude})


