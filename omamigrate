        "omarchy": m.get("omarchy"), "selection": m.get("selection"),
        "categories": m.get("categories"),
        "files": len(m.get("files", [])),
        "packages": len(m.get("packages", [])),
        "plugins": [p["id"] for p in m.get("plugins", [])],
        "themes": [t["name"] for t in m.get("themes", [])],
        "defaults": m.get("defaults"),
    }, indent=2))
    return 0


def repo_package_names():
    """Names available in the configured pacman repos, or None on error."""
    try:
        out = run(["pacman", "-Ssq"]).stdout
    except Exception:
        return None
    return {line.split("/", 1)[0].strip() for line in out.splitlines()
            if "/" in line}


def remaining_steps(manifest):
    """Things that can't be carried over automatically and need a hand."""
    rels = [f["rel"] for f in manifest.get("files", [])]
    # Use the *selected* categories, not every category the machine has.
    cats = set(manifest.get("selection", {}).get("categories", []))
    steps = []
    if any(r.startswith(".config/tailscale") or r.startswith(".local/share/tailscale")
           for r in rels):
        steps.append({"label": "Reconnect your tailnet",
                      "cmd": "sudo tailscale up",
                      "why": "Tailscale auth state can't be copied — reconnect here."})
    if any(r.startswith(".config/omagrid") or r.startswith(".omagrid") for r in rels):
        steps.append({"label": "Re-authenticate omagrid",
                      "cmd": "omagrid login",
                      "why": "Grid credentials don't transfer — log in again."})
    if "secrets" in cats:
        steps.append({"label": "Unlock your keyring",
                      "cmd": "seahorse",
                      "why": "Copied SSH/GPG keys need the keyring unlocked to use."})
    if any(r.endswith(".service") or r.startswith(".config/systemd") for r in rels):
        steps.append({"label": "Enable any copied systemd units",
                      "cmd": "systemctl --user --failed",
                      "why": "Units are copied but not enabled on this box."})
    steps.append({"label": "Restart your shell",
                  "cmd": "omarchy restart shell",
                  "why": "Pick up the restored configuration."})
    return steps


def _ver_unknown(v):
    return v in (None, "", "?")


def verify_bundle(bundle, events=False, passphrase=None):
    m = read_manifest(bundle, passphrase)
    ok = missing = 0
    missing_items = []
    for f in m.get("files", []):
        p = HOME / f["rel"]
        if p.exists() and p.stat().st_size == f["bytes"]:
            ok += 1
            continue
        reason = "size mismatch" if p.exists() else "not found"
        missing += 1
        if len(missing_items) < 80:
            missing_items.append({"rel": f["rel"], "reason": reason})
    # The manifest always carries the machine's full package list; only report
    # on packages the bundle was actually asked to carry.
    sel_cats = set(m.get("selection", {}).get("categories", []))
    pkgs = m.get("packages", []) if "packages" in sel_cats else []
    installed = set()
    try:
        installed = set(run(["pacman", "-Qq"]).stdout.split())
    except Exception:
        pass
    avail = repo_package_names()
    pkgs_missing = []
    for p in pkgs:
        if p in installed:
            continue
        in_repo = avail is not None and p in avail
        pkgs_missing.append({
            "name": p,
            "kind": "repo" if in_repo else "aur",
            "how": "sudo pacman -S " + p if in_repo else "yay -S " + p,
        })
    om_from = m.get("omarchy", {}) or {}
    from_v = om_from.get("version") or "?"
    from_c = om_from.get("channel") or "?"
    now_v = omarchy_version() or "?"
    now_c = omarchy_channel() or "?"
    report = {
        "files_ok": ok, "files_missing": missing,
        "files_missing_sample": missing_items,
        "packages_total": len(pkgs),
        "packages_missing": pkgs_missing,
        "packages_missing_count": len(pkgs_missing),
        "omarchy": {"from": from_v, "now": now_v,
                    "channel_from": from_c, "channel_now": now_c,
                    "match": _ver_unknown(from_v) or _ver_unknown(now_v)
                    or from_v == now_v},
        "manual_steps": remaining_steps(m),
        "ok": missing == 0 and not pkgs_missing,
    }
    if events:
        emit(events, {"event": "done", **report})
    else:
        print(json.dumps(report, indent=2))
    return 0 if report["ok"] else 2


def cmd_verify(args):
    return verify_bundle(args.bundle, args.events, args.passphrase)


