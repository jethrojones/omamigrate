OP_POINTER_MAGIC = "op-document"


def _last_line(s):
    s = (s or "").strip()
    return s.splitlines()[-1] if s else "no output"


_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b[=>]")


def _first_error_line(s):
    """The first 'error' line of a CLI transcript, else its last line."""
    s = _ANSI_RE.sub("", s or "")
    lines = s.strip().splitlines()
    for line in lines:
        if "error" in line.lower():
            return line.strip()
    return lines[-1].strip() if lines else "no output"


def op_signed_in():
    """True if the 1Password CLI has a signed-in account to use."""
    if not has("op"):
        return False
    r = run(["op", "account", "list", "--format", "json"])
    if r.returncode != 0:
        return False
    try:
        accts = json.loads(r.stdout or "[]")
    except json.JSONDecodeError:
        return False
    return isinstance(accts, list) and len(accts) > 0


def protect_usable(method):
    """None if the protection method can run here, else an error string."""
    if method == "1password":
        if not has("op"):
            return "the 1Password CLI (op) is not installed. Use --protect age."
        if not op_signed_in():
            return ("no 1Password account is signed in to the CLI "
                    "(see: op account list). Sign in, or use --protect age.")
        return None
    if method == "age":
        if not has("age"):
            return "age is not installed. Install it: sudo pacman -S age"
        return None
    return f"unknown protection method: {method}"


def age_passphrase(cmd, passphrase):
    """Run an age command that prompts for a passphrase on a TTY.

    age only reads the passphrase from a terminal, so the child gets a
    pseudo-terminal and its prompts are answered from it.
    Returns (returncode, output text with the passphrase masked).
    """
    master, slave = pty.openpty()
    buf = b""
    try:
        # start_new_session: age prefers /dev/tty for its passphrase prompt;
        # in a new session there is no controlling tty, so it falls back to
        # stdin (our pty), where we can feed the passphrase.
        proc = subprocess.Popen(cmd, stdin=slave, stdout=slave,
                                stderr=slave, close_fds=True,
                                start_new_session=True)
        os.close(slave)
        answered = 0
        deadline = time.time() + 600
        while True:
            if time.time() > deadline:
                proc.kill()
                text = buf.decode("utf-8", "replace")
                if passphrase:
                    text = text.replace(passphrase, "***")
                return 124, text + "\nage: timed out"
            try:
                r, _, _ = select.select([master], [], [], 5)
            except OSError:
                break
            if not r:
                continue
            try:
                chunk = os.read(master, 65536)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
            low = buf.lower()
            prompts = low.count(b"enter passphrase") + \
                low.count(b"confirm passphrase")
            while answered < prompts:
                os.write(master, (passphrase + "\n").encode())
                answered += 1
        while True:
            try:
                r, _, _ = select.select([master], [], [], 0.2)
            except OSError:
                break
            if not r:
                break
            try:
                chunk = os.read(master, 65536)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
        proc.wait()
        text = buf.decode("utf-8", "replace")
        if passphrase:
            text = text.replace(passphrase, "***")
        return proc.returncode, text
    finally:
        try:
            os.close(master)
        except OSError:
            pass


def _op_pointer(p):
    """Parse and validate a .op pointer file. Returns its metadata."""
    try:
        meta = json.loads(Path(p).read_text())
    except (OSError, json.JSONDecodeError) as e:
        raise SystemExit(f"{p.name} is not a valid 1Password bundle "
                         f"pointer: {e}")
    if not isinstance(meta, dict) or \
            meta.get("omamigrate") != OP_POINTER_MAGIC or \
            not meta.get("item_id"):
        raise SystemExit(f"{p.name} is not an omamigrate 1Password pointer")
    return meta


def resolve_bundle(bundle, passphrase=None):
    """Decrypt a bundle if needed. The single decrypt entry point.

    Plain bundle  -> (bundle, False); caller owns the path.
    <name>.age    -> age-decrypted (passphrase arg or OMAMIGRATE_PASSPHRASE)
    <name>.op     -> downloaded from 1Password with the signed-in op account
    In both cases returns (temp_path, True); the caller must delete the
    temp file when done.
    """
    p = Path(bundle)
    if p.suffix == ".age":
        pw = passphrase or os.environ.get("OMAMIGRATE_PASSPHRASE")
        if not pw:
            raise SystemExit(f"{p.name} is age-encrypted. Pass the "
                             "passphrase with --passphrase or set "
                             "OMAMIGRATE_PASSPHRASE.")
        if not has("age"):
            raise SystemExit("age is not installed; install it to decrypt "
                             "this bundle: sudo pacman -S age")
        tmp = Path(tempfile.mkstemp(prefix="omamigrate-decrypt-",
                                    suffix=".tar.zst")[1])
        # age -d auto-detects passphrase-protected files and prompts;
        # the input file must come after all flags
        rc, out = age_passphrase(
            ["age", "-d", "-o", str(tmp), str(p)], pw)
        if rc != 0:
            tmp.unlink(missing_ok=True)
            if "no identity" in out or "incorrect passphrase" in out:
                raise SystemExit(f"Could not decrypt {p.name}: wrong "
                                 "passphrase (or the file is not "
                                 "age-encrypted).")
            raise SystemExit("age decrypt failed: " + _first_error_line(out))
        return tmp, True
    if p.suffix == ".op":
        meta = _op_pointer(p)
        if not has("op"):
            raise SystemExit(f"{p.name} is protected with 1Password, but "
                             "the 1Password CLI (op) is not installed "
                             "here.")
        if not op_signed_in():
            raise SystemExit(f"{p.name} is protected with 1Password. Sign "
                             "in to the CLI first (op signin), then retry.")
        tmp = Path(tempfile.mkstemp(prefix="omamigrate-op-",
                                    suffix=".tar.zst")[1])
        r = run(["op", "document", "get", meta["item_id"], "-o", str(tmp),
                 "--force"])
        if r.returncode != 0:
            tmp.unlink(missing_ok=True)
            raise SystemExit("Could not download the 1Password document: "
                             + _last_line(r.stderr or r.stdout))
        return tmp, True
    return p, False


def protect_bundle(path, protect, events):
    """Encrypt a freshly written plaintext bundle, then delete the
    plaintext. Returns the final path (.age file or .op pointer)."""
    path = Path(path)
    method = protect.get("method")
    err = protect_usable(method)
    if err:
        path.unlink(missing_ok=True)
        raise SystemExit(err)
    if method == "age":
        pw = protect.get("passphrase") or os.environ.get("OMAMIGRATE_PASSPHRASE")
        if not pw:
            path.unlink(missing_ok=True)
            raise SystemExit("age protection needs a passphrase "
                             "(--passphrase or OMAMIGRATE_PASSPHRASE)")
        emit(events, {"event": "log", "line": "encrypting with age "
                                             "(passphrase)"})
        out = path.with_name(path.name + ".age")
        rc, out_txt = age_passphrase(
            ["age", "-e", "-p", "-o", str(out), str(path)], pw)
        if rc != 0:
            path.unlink(missing_ok=True)
            out.unlink(missing_ok=True)
            raise SystemExit("age encrypt failed: " + _first_error_line(out_txt))
        path.unlink()
        return out
    if method == "1password":
        title = "omamigrate bundle " + datetime.now().strftime("%Y-%m-%d %H:%M")
        emit(events, {"event": "log",
                      "line": "encrypting with 1Password (op document create)"})
        r = run(["op", "document", "create", str(path), "--title", title,
                 "--file-name", path.name, "--format", "json"])
        if r.returncode != 0:
            path.unlink(missing_ok=True)
            raise SystemExit("op document create failed: "
                             + _last_line(r.stderr or r.stdout))
        item_id = None
        try:
            item = json.loads(r.stdout)
            if isinstance(item, dict):
                item_id = item.get("id")
        except json.JSONDecodeError:
            pass
        if not item_id:
            path.unlink(missing_ok=True)
            raise SystemExit("op document create: could not read the "
                             "document id from: " + r.stdout.strip()[:200])
        out = path.with_name(path.name + ".op")
        out.write_text(json.dumps({
            "omamigrate": OP_POINTER_MAGIC,
            "method": "1password",
            "item_id": item_id,
            "file_name": path.name,
            "title": title,
        }, indent=2))
        path.unlink()
        return out
    path.unlink(missing_ok=True)
    raise SystemExit(f"unknown protection method: {method}")


