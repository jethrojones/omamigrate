def desktop_to_name(d):
    table = {
        "Alacritty.desktop": "alacritty", "foot.desktop": "foot",
        "com.mitchellh.ghostty.desktop": "ghostty", "kitty.desktop": "kitty",
        "chromium.desktop": "chromium", "google-chrome.desktop": "chrome",
        "brave-browser.desktop": "brave", "firefox.desktop": "firefox",
        "microsoft-edge.desktop": "edge",
    }
    return table.get(d, d)


def name_to_desktop(n):
    for d, name in {
        "alacritty": "Alacritty.desktop", "foot": "foot.desktop",
        "ghostty": "com.mitchellh.ghostty.desktop", "kitty": "kitty.desktop",
        "chromium": "chromium.desktop", "chrome": "google-chrome.desktop",
        "brave": "brave-browser.desktop", "firefox": "firefox.desktop",
        "edge": "microsoft-edge.desktop",
    }.items():
        if n == name:
            return d
    return f"{n}.desktop"


def current_theme():
    return read_state_file(OMSTATE / "current" / "theme.name")


def theme_colors():
    """Read the active theme's colors.toml so the UI wears the user's theme."""
    name = current_theme()
    tdir = None
    if name:
        for cand in (CFG / "omarchy" / "themes" / name,
                     Path("/usr/share/omarchy/themes") / name):
            if (cand / "colors.toml").exists():
                tdir = cand
                break
    if not tdir:
        return None
    try:
        import tomllib
        with open(tdir / "colors.toml", "rb") as f:
            data = tomllib.load(f)
        return {
            "background": data.get("background", "#0a0a0f"),
            "foreground": data.get("foreground", "#e6e6e6"),
            "accent": data.get("accent", "#0072CE"),
            "muted": data.get("muted", "#666"),
            "green": data.get("green", "#79bc6e"),
            "red": data.get("red", "#e06c75"),
            "yellow": data.get("yellow", "#e5c07b"),
            "cyan": data.get("cyan", "#56b6c2"),
            "magenta": data.get("magenta", "#c678dd"),
            "lighter_background": data.get("lighter_background", "#1b1c21"),
        }
    except Exception:
        return None


