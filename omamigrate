def latest_bundle():
    return newest(list(BUNDLE_DIR.glob("omamigrate-*.tar.*")))


GUI_PROCS = {}


def spawn_stream(args_list):
    return subprocess.Popen(args_list, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True,
                            bufsize=1)


def stream_proc(proc):
    try:
        for line in proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                yield {"event": "log", "line": line}
    finally:
        proc.wait()


def make_gui_handler(page_html):
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _json(self, obj, code=200):
            body = json.dumps(obj, default=str).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _sse(self, gen):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            for ev in gen:
                try:
                    self.wfile.write(
                        f"data: {json.dumps(ev, default=str)}\n\n".encode())
                    self.wfile.flush()
                except (BrokenPipeError, ConnectionResetError):
                    return

        def _body(self):
            n = int(self.headers.get("Content-Length", 0))
            return json.loads(self.rfile.read(n) or b"{}")

        def do_OPTIONS(self):
            self.send_response(204)
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
            self.send_header("Access-Control-Allow-Headers", "Content-Type")
            self.end_headers()

        def do_GET(self):
            path = urllib.parse.urlparse(self.path).path
            if path in ("/", "/index.html"):
                body = page_html.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif path == "/api/health":
                self._json({"ok": True, "version": VERSION, "host": socket.gethostname()})
            else:
                self._json({"error": "not found"}, 404)

        def do_POST(self):
            path = urllib.parse.urlparse(self.path).path
            try:
                if path == "/api/scan":
                    self._json(build_inventory())
                elif path == "/api/pack":
                    b = self._body()
                    out = b.get("out") or str(
                        BUNDLE_DIR /
                        f"omamigrate-{socket.gethostname()}-{datetime.now():%Y%m%d-%H%M%S}.tar.zst")
                    sel = b.get("select")
                    cmd = [sys.executable, os.path.abspath(__file__), "pack",
                           "--events", "--out", out]
                    # The GUI sends the explicit category list; it is the
                    # authoritative selection. Fall back to --all (carbon =
                    # everything) only when no list is given.
                    if sel:
                        cmd += ["--select", ",".join(sel)]
                    elif b.get("carbon"):
                        cmd.append("--all")
                    proc = spawn_stream(cmd)
                    self._sse(stream_proc(proc))
                elif path == "/api/serve":
                    b = self._body()
                    if GUI_PROCS.get("serve") and GUI_PROCS["serve"].poll() is None:
                        self._json(GUI_PROCS.get("served") or {"error": "already serving"})
                        return
                    bundle = b.get("bundle") or (latest_bundle() and str(latest_bundle()))
                    if not bundle:
                        self._json({"error": "no bundle — pack one first"}, 400)
                        return
                    proc = spawn_stream(
                        [sys.executable, os.path.abspath(__file__), "serve",
                         "--events", "--bundle", bundle])
                    line = proc.stdout.readline()
                    try:
                        first = json.loads(line)
                    except json.JSONDecodeError:
                        first = {"error": f"serve failed: {line.strip()}"}
                    if first.get("event") != "serving":
                        proc.kill()
                        self._json(first, 500)
                        return
                    GUI_PROCS["serve"] = proc
                    GUI_PROCS["served"] = first
                    self._json(first)
                elif path == "/api/stop":
                    p = GUI_PROCS.get("serve")
                    if p and p.poll() is None:
                        p.terminate()
                    GUI_PROCS.pop("serve", None)
                    GUI_PROCS.pop("served", None)
                    self._json({"ok": True})
                elif path == "/api/load":
                    b = self._body()
                    self._sse(self._load_gen(b))
                elif path == "/api/apply":
                    b = self._body()
                    bundle = b.get("bundle")
                    if not bundle:
                        self._json({"error": "no bundle"}, 400)
                        return
                    cmd = [sys.executable, os.path.abspath(__file__), "apply",
                           bundle, "--events"]
                    if b.get("dry_run"):
                        cmd.append("--dry-run")
                    if b.get("select"):
                        cmd += ["--select", ",".join(b["select"])]
                    if b.get("exclude"):
                        cmd += ["--exclude", ",".join(b["exclude"])]
                    proc = spawn_stream(cmd)
                    self._sse(stream_proc(proc))
                elif path == "/api/verify":
                    b = self._body()
                    r = subprocess.run(
                        [sys.executable, os.path.abspath(__file__), "verify",
                         b.get("bundle", "")], capture_output=True, text=True)
                    try:
                        self._json(json.loads(r.stdout))
                    except json.JSONDecodeError:
                        self._json({"error": r.stderr or r.stdout}, 500)
                elif path == "/api/agent":
                    agent = default_agent()
                    if not agent:
                        self._json({"error": "no default agent set"}, 400)
                        return
                    subprocess.Popen(
                        ["omarchy", "agent", "prompt", AGENT_PROMPT],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        start_new_session=True)
                    self._json({"ok": True, "agent": agent})
                else:
                    self._json({"error": "not found"}, 404)
            except Exception as e:
                self._json({"error": str(e)}, 500)

        def _load_gen(self, b):
            url = b.get("url")
            dest_path = b.get("path")
            if url:
                dest = INBOX / Path(urllib.parse.urlparse(url).path.split("/")[-1]
                                    or "bundle.tar.zst")
                INBOX.mkdir(parents=True, exist_ok=True)
                total = None
                done = 0
                try:
                    req = urllib.request.Request(url)
                    with urllib.request.urlopen(req, timeout=30) as r:
                        total = int(r.headers.get("Content-Length", 0)) or None
                        with open(dest, "wb") as f:
                            while True:
                                chunk = r.read(1024 * 256)
                                if not chunk:
                                    break
                                f.write(chunk)
                                done += len(chunk)
                                yield {"event": "download", "done": done,
                                       "total": total or done}
                except Exception as e:
                    yield {"event": "error", "line": str(e)}
                    return
                dest_path = str(dest)
            if not dest_path or not Path(dest_path).exists():
                yield {"event": "error", "line": "bundle not found"}
                return
            yield from self._manifest_gen(dest_path)

        def _manifest_gen(self, dest_path):
            try:
                m = read_manifest(dest_path)
            except Exception as e:
                yield {"event": "error", "line": f"cannot read bundle: {e}"}
                return
            yield {"event": "ready", "path": dest_path, "manifest": m}

    return H


def build_page():
    template = HTML
    # Dev convenience: prefer a sibling gui_template.html so the dashboard can
    # be edited without re-embedding. The packaged app ships no sibling, so it
    # falls back to the embedded copy.
    t = Path(__file__).with_name("gui_template.html")
    if t.exists():
        try:
            template = t.read_text()
        except OSError:
            pass
    colors = theme_colors() or {}
    theme_css = f"""
:root {{
  --bg: {colors.get('background', '#0a0a0f')};
  --bg2: {colors.get('lighter_background', '#1b1c21')};
  --fg: {colors.get('foreground', '#e6e6e6')};
  --muted: {colors.get('muted', '#8a8f98')};
  --accent: {colors.get('accent', '#0072CE')};
  --green: {colors.get('green', '#79bc6e')};
  --red: {colors.get('red', '#e06c75')};
  --yellow: {colors.get('yellow', '#e5c07b')};
  --cyan: {colors.get('cyan', '#56b6c2')};
  --magenta: {colors.get('magenta', '#c678dd')};
}}"""
    return template.replace("/*__THEME__*/", theme_css).replace(
        "__VERSION__", VERSION).replace("__HOST__", socket.gethostname())


def cmd_gui(args):
    BUNDLE_DIR.mkdir(parents=True, exist_ok=True)
    INBOX.mkdir(parents=True, exist_ok=True)
    port = args.port or 0
    server = ThreadingHTTPServer(("127.0.0.1", port), make_gui_handler(build_page()))
    port = server.server_address[1]
    url = f"http://127.0.0.1:{port}"
    print(f"omamigrate dashboard: {url}", file=sys.stderr)
    if (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")) \
            and has("xdg-open"):
        try:
            subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except OSError:
            pass
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


