def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def emit(events, obj):
    if events:
        print(json.dumps(obj, default=str), flush=True)


def walk_files(base: Path, rel: str):
    """Yield (relpath, size) for every regular file under base."""
    out = []
    if base.is_file():
        try:
            out.append((rel, base.stat().st_size))
        except OSError:
            pass
        return out
    if not base.is_dir():
        return out
    for root, dirs, files in os.walk(base):
        dirs[:] = [d for d in dirs if d not in EXCLUDE_DIRS]
        for name in files:
            if name.endswith(".lock"):
                continue
            p = Path(root) / name
            r = str(Path(rel) / p.relative_to(base))
            try:
                if p.is_symlink():
                    continue
                st = p.stat()
            except OSError:
                continue
            out.append((r, st.st_size))
    return out


def dir_stats(base: Path, rel: str):
    files = walk_files(base, rel)
    return len(files), sum(s for _, s in files)


def newest(paths):
    best, bt = None, 0
    for p in paths:
        try:
            m = p.stat().st_mtime
        except OSError:
            continue
        if m > bt:
            best, bt = p, m
    return best


