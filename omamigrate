def lan_ips():
    ips = []
    try:
        out = run(["hostname", "-I"]).stdout.split()
        ips = [ip for ip in out if ip.startswith("192.168") or ip.startswith("10.")
               or ip.startswith("172.")]
    except FileNotFoundError:
        pass
    if not ips:
        try:
            ips = [socket.gethostbyname(socket.gethostname())]
        except OSError:
            ips = ["127.0.0.1"]
    return ips or ["127.0.0.1"]


