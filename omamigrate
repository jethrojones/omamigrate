class _DecryptedBundle:
    """A tarfile view over a decrypted temp bundle; removes the temp
    file when closed."""

    def __init__(self, tf, tmp):
        self._tf = tf
        self._tmp = tmp

    def __getattr__(self, name):
        return getattr(self._tf, name)

    def close(self):
        self._tf.close()
        if self._tmp:
            Path(self._tmp).unlink(missing_ok=True)
            self._tmp = None

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()
        return False


def open_bundle(bundle, passphrase=None):
    """Open a bundle for reading. Encrypted bundles (.age/.op) are
    decrypted to a temp file first; closing the result removes it."""
    real, temp = resolve_bundle(bundle, passphrase)
    if not temp:
        return tarfile.open(str(real), "r:*")
    return _DecryptedBundle(tarfile.open(str(real), "r:*"), real)


def read_manifest(bundle, passphrase=None):
    bundle = Path(bundle)
    if bundle.suffix == ".json":
        return json.loads(bundle.read_text())
    real, temp = resolve_bundle(bundle, passphrase)
    try:
        try:
            with open_bundle(str(real)) as tf:
                m = tf.extractfile("omamigrate/manifest.json")
                if not m:
                    raise SystemExit(f"No manifest in {bundle}")
                return json.loads(m.read())
        except tarfile.TarError:
            # older pythons can't read zstd natively; fall back to tar
            r = run(["tar", "--zstd", "-xf", str(real),
                     "omamigrate/manifest.json", "-C", tempfile.mkdtemp(prefix="omam-")])
            if r.returncode != 0:
                raise SystemExit(f"Cannot open bundle: {r.stderr.strip()}")
            import glob
            g = glob.glob(tempfile.gettempdir() + "/omam-*/omamigrate/manifest.json")
            return json.loads(Path(g[0]).read_text()) if g else None
    finally:
        if temp:
            Path(real).unlink(missing_ok=True)


def extract_bundle(bundle, dest, passphrase=None):
    real, temp = resolve_bundle(bundle, passphrase)
    try:
        if str(real).endswith(".tar.zst"):
            r = run(["tar", "--zstd", "-xf", str(real), "-C", str(dest)])
            if r.returncode == 0:
                return
        with open_bundle(str(real)) as tf:
            tf.extractall(dest)
    finally:
        if temp:
            Path(real).unlink(missing_ok=True)


def cmd_unpack(args):
    m = read_manifest(args.bundle, args.passphrase)
    print(json.dumps({
