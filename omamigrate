def pack_bundle(inv, selection, out, events, mode="selective",
                include_packages=False, protect=None):
    emit(events, {"event": "start", "phase": "gather"})
    files = []
    seen = set()
    selset = set(selection)
    for cat in inv["categories"]:
        for it in cat["items"]:
            if it["id"] not in selset:
                continue
            base = HOME / it["rel"]
            if base.is_file():
                files.append((it["rel"], str(base)))
                seen.add(it["rel"])
            else:
                for rel, _size in walk_files(base, it["rel"]):
                    if rel not in seen:
                        seen.add(rel)
                        files.append((rel, str(HOME / rel)))
    files.sort()
    total = len(files)
    emit(events, {"event": "count", "total": total,
                  "bytes": sum(os.path.getsize(p) for _, p in files
                               if os.path.exists(p))})

    tmp = Path(tempfile.mkdtemp(prefix="omamigrate-pack-"))
    root = tmp / "omamigrate"
    (root / "files").mkdir(parents=True)

    step = max(1, total // 400)
    for i, (rel, src) in enumerate(files, 1):
        dest = root / "files" / rel
        try:
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest, follow_symlinks=True)
        except OSError as e:
            emit(events, {"event": "log", "line": f"skip {rel}: {e}"})
        if i % step == 0 or i == total:
            emit(events, {"event": "file", "done": i, "total": total,
                          "name": rel})

    plugins = []
    themes = []
    for cat in inv["categories"]:
        for m in cat["meta"].get("plugins", []):
            if f".config/omarchy/plugins/{m['id']}" in selset:
                plugins.append(m)
        for m in cat["meta"].get("themes", []):
            if f".config/omarchy/themes/{m['name']}" in selset:
                themes.append(m)

    defaults_meta = {}
    for cat in inv["categories"]:
        if cat["id"] == "defaults" and any(
                it["id"] in selset for it in cat["items"]):
            defaults_meta = cat["meta"]

    # which category does each selected prefix belong to?
    cat_of_prefix = {}
    for cat in inv["categories"]:
        for it in cat["items"]:
            if it["id"] in selset:
                cat_of_prefix[it["rel"].rstrip("/")] = cat["id"]

    def cat_for(rel):
        best = None
        for prefix, cid in cat_of_prefix.items():
            if (rel == prefix or rel.startswith(prefix + "/")) and \
                    (best is None or len(prefix) > len(best[1])):
                best = (cid, prefix)
        return best[0] if best else "misc"

    files_manifest = []
    for r, s in files:
        try:
            size = os.path.getsize(s)
        except OSError:
            size = 0
        files_manifest.append({"rel": r, "bytes": size, "cat": cat_for(r)})

    theme_name = current_theme()
    theme_selected = any(
        it["id"].startswith(".config/omarchy/themes/") for it in
        (it for c in inv["categories"] for it in c["items"])
        if it["id"] in selset)
    if theme_name and theme_selected:
        bg_link = OMSTATE / "current" / "background"
        bg_rel = None
        try:
            target = os.readlink(str(bg_link))
            m = re.search(r"themes/([^/]+)/backgrounds/([^/]+)$", target)
            if m:
                bg_rel = f"themes/{m.group(1)}/backgrounds/{m.group(2)}"
        except OSError:
            pass
        defaults_meta = {**defaults_meta, "theme": theme_name,
                         "background": bg_rel}

    cat_counts = {}
    for f in files_manifest:
        c = cat_counts.setdefault(f["cat"], {"label": "Misc", "files": 0,
                                             "bytes": 0})
        c["files"] += 1
        c["bytes"] += f["bytes"]
    for c in inv["categories"]:
        if c["id"] not in cat_counts:
            cat_counts[c["id"]] = {"label": c["label"], "files": 0, "bytes": 0}
    for cid, c in cat_counts.items():
        c["label"] = next((x["label"] for x in inv["categories"]
                           if x["id"] == cid), c["label"])

    manifest = {
        "app": APP,
        "format": 1,
        "created": datetime.now().isoformat(timespec="seconds"),
        "host": inv["host"],
        "user": inv["user"],
        "omarchy": {"version": inv["omarchy"], "channel": inv["channel"]},
        "selection": {"mode": mode, "categories": [], "items": selection},
        "categories": cat_counts,
        "files": files_manifest,
        "plugins": plugins,
        "themes": themes,
        "packages": sorted({m for c in inv["categories"]
                            if c["id"] == "packages"
                            for m in c["meta"].get("packages", [])}),
        "defaults": defaults_meta,
    }
    if protect:
        manifest["protect"] = {"method": protect["method"]}
    manifest["selection"]["categories"] = sorted(
        cid for cid, v in cat_counts.items() if v["files"])
    if include_packages and manifest["packages"]:
        manifest["selection"]["categories"].append("packages")
        manifest["selection"]["categories"].sort()

    (root / "manifest.json").write_text(json.dumps(manifest, indent=2))
    if manifest["packages"]:
        (root / "packages.txt").write_text("\n".join(manifest["packages"]) + "\n")

    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)
    emit(events, {"event": "phase", "phase": "compress"})
    if has("zstd"):
        r = run(["tar", "--zstd", "-cf", str(out), "-C", str(tmp), "omamigrate"])
        if r.returncode != 0:
            emit(events, {"event": "log", "line": r.stderr.strip()})
            out = out.with_suffix(".tar.gz")
            with tarfile.open(out, "w:gz") as tf:
                tf.add(root, arcname="omamigrate")
    else:
        out = out.with_suffix(".tar.gz")
        with tarfile.open(out, "w:gz") as tf:
            tf.add(root, arcname="omamigrate")
    shutil.rmtree(tmp, ignore_errors=True)
    if protect:
        emit(events, {"event": "phase", "phase": "protect"})
        out = protect_bundle(out, protect, events)
    size = out.stat().st_size
    emit(events, {"event": "done", "path": str(out), "bytes": size,
                  "files": len(manifest["files"])})
    return out, manifest


def cmd_pack(args):
    inv = build_inventory()
    out = args.out or str(
        BUNDLE_DIR / f"omamigrate-{inv['host']}-{datetime.now():%Y%m%d-%H%M%S}.tar.zst")
    mode = "selective"
    if args.all:
        select = carbon_items(inv)
        mode = "carbon"
    elif args.select:
        vals = args.select.split(",")
        if all(v in category_ids(inv) for v in vals):
            select = expand_categories(inv, vals)
        else:
            select = resolve_selection(inv, select=vals)
        mode = "carbon" if set(vals) == category_ids(inv) else "selective"
    else:
        select = []
    has_pkgs = any(c["id"] == "packages" and c["meta"].get("packages")
                   for c in inv["categories"])
    want_pkgs = args.all or (args.select and
                             "packages" in args.select.split(","))
    if not select and not want_pkgs and not has_pkgs:
        print("Nothing selected. Use --all or --select cat1,cat2 "
              "(see: omamigrate scan)", file=sys.stderr)
        return 1
    protect = None
    if args.protect:
        method = args.protect
        if method == "auto":
            method = "1password" if op_signed_in() else "age"
        protect = {"method": method, "passphrase": args.passphrase}
        err = protect_usable(method)
        if not err and method == "age" and not (
                args.passphrase or os.environ.get("OMAMIGRATE_PASSPHRASE")):
            err = ("age protection needs a passphrase "
                   "(--passphrase or OMAMIGRATE_PASSPHRASE)")
        if err:
            print(err, file=sys.stderr)
            return 1
    out, _ = pack_bundle(inv, select, out, args.events, mode=mode,
                         include_packages=want_pkgs or args.all,
                         protect=protect)
    if not args.events:
        print(f"Bundle ready: {out}")
    return 0


