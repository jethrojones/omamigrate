def cmd_install_menu(args):
    menu = CFG / "omarchy" / "extensions" / "omarchy-menu.jsonc"
    if menu.exists():
        text = menu.read_text()
    else:
        menu.parent.mkdir(parents=True, exist_ok=True)
        text = "{\n}\n"
    # Remove any old flat entry and the new nested one before rewriting.
    text = re.sub(r'\n?\s*"(?:apps\.)?omamigrate":\s*\{[^}]*\},?', "", text)
    installed = os.path.join(str(HOME), ".local", "bin", "omamigrate")
    exe = os.path.abspath(
        os.environ.get("OMAMIGRATE_BIN",
                       installed if os.path.exists(installed) else __file__))
    # Dotted id "apps.omamigrate" makes the menu nest it under the Apps menu
    # instead of dropping it at the root level.
    entry = ('  "apps.omamigrate": {"icon":"📦","label":"Omamigrate",'
             '"action":"' + exe + '","description":'
             '"Move your Omarchy to a new machine"},\n')
    idx = text.rfind("}")
    text = text[:idx] + entry + text[idx:]
    menu.write_text(text)
    print(f"Menu entry added to {menu}")
    return 0


