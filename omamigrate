def make_serve_handler(bundle, token, manifest_bytes):
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="text/plain; charset=utf-8"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            path = urllib.parse.urlparse(self.path).path.strip("/")
            parts = path.split("/")
            if len(parts) != 2 or parts[0] != token:
                self._send(404, "not found")
                return
            name = parts[1]
            if name == "":
                page = SERVE_PAGE.format(
                    host=socket.gethostname(), accent="#0072CE", token=token,
                    fname=bundle.name, size=human(bundle.stat().st_size),
                    url=f"http://{lan_ips()[0]}:{self.server.server_address[1]}/{token}/{bundle.name}")
                self._send(200, page.encode(), "text/html; charset=utf-8")
            elif name == "manifest.json":
                self._send(200, manifest_bytes, "application/json")
            elif name == bundle.name:
                self.send_response(200)
                self.send_header("Content-Type",
                                 "application/x-tar")
                self.send_header("Content-Disposition",
                                 f'attachment; filename="{bundle.name}"')
                self.send_header("Content-Length",
                                 str(bundle.stat().st_size))
                self.end_headers()
                with open(bundle, "rb") as f:
                    while True:
                        chunk = f.read(1024 * 1024)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
            else:
                self._send(404, "not found")

    return H


def cmd_serve(args):
    events = args.events
    bundle = Path(args.bundle) if args.bundle else newest(
        list(BUNDLE_DIR.glob("omamigrate-*.tar.*")))
    if not bundle or not bundle.exists():
        print("No bundle found. Run: omamigrate pack --all", file=sys.stderr)
        return 1
    token = secrets.token_urlsafe(6)
    port = args.port
    if not port:
        port = 8787
        while True:
            s = socket.socket()
            try:
                s.bind(("0.0.0.0", port))
                s.close()
                break
            except OSError:
                port += 1
            if port > 8797:
                break
    manifest_bytes = b"{}"
    try:
        manifest_bytes = json.dumps(read_manifest(bundle)).encode()
    except (Exception, SystemExit):
        # encrypted bundles can't be read without the passphrase; serve
        # the file anyway, the receiver decrypts it locally
        pass
    server = ThreadingHTTPServer(("0.0.0.0", port),
                                 make_serve_handler(bundle, token, manifest_bytes))
    urls = [f"http://{ip}:{port}/{token}/" for ip in lan_ips()]
    emit(events, {"event": "serving", "urls": urls, "port": port,
                  "token": token, "file": str(bundle),
                  "bytes": bundle.stat().st_size})
    if not events:
        print(f"Serving {bundle.name} ({human(bundle.stat().st_size)}):")
        for u in urls:
            print(f"  {u}")
        print("Stop with Ctrl-C.")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


