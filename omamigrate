def apply_step(events, step_id, label, fn):
    emit(events, {"event": "step", "id": step_id, "label": label,
                  "status": "start"})
    try:
        detail = fn() or ""
        emit(events, {"event": "step", "id": step_id, "status": "done",
                      "detail": detail})
        return True
    except Exception as e:
        emit(events, {"event": "step", "id": step_id, "status": "error",
                      "detail": str(e)})
        return False


def cmd_apply(args):
    events = args.events
    bundle = Path(args.bundle)
    if not bundle.exists():
        print(f"No such bundle: {bundle}", file=sys.stderr)
        return 1
    dry = args.dry_run

    emit(events, {"event": "phase", "phase": "open"})
    tmp = Path(tempfile.mkdtemp(prefix="omamigrate-apply-"))
    extract_bundle(bundle, tmp, args.passphrase)
    root = tmp / "omamigrate"
    manifest = json.loads((root / "manifest.json").read_text())
    emit(events, {"event": "manifest", "manifest": manifest})

    # selection: category ids, item rels, or the bundle's own selection
    bundle_cats = set(manifest.get("categories", {}).keys())
    exclude = set(args.exclude.split(",")) if args.exclude else set()
    if args.select:
        vals = args.select.split(",")
        if all(v in bundle_cats for v in vals):
            sel_cats = set(vals)
            sel_rels = [f["rel"] for f in manifest.get("files", [])
                        if f.get("cat") in sel_cats]
        else:
            sel_rels = vals
            sel_cats = {f.get("cat") for f in manifest.get("files", [])
                        if f["rel"] in set(vals)}
    else:
        sel_rels = list(manifest.get("selection", {}).get("items", []))
        sel_cats = set(manifest.get("selection", {}).get("categories", []))
    sel_rels = [r for r in sel_rels if r not in exclude]
    selset = set(sel_rels)

    stats = {"files": 0, "backed_up": 0, "packages": 0,
             "plugins": 0, "themes": 0, "skipped": []}
    backup_dir = WORK / "backups" / datetime.now().strftime("%Y%m%d-%H%M%S")

    def step_backup():
        if dry:
            return "dry run"
        n = 0
        for rel in sel_rels:
            p = HOME / rel
            if p.is_file() and p.exists():
                dest = backup_dir / rel
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(p), str(dest))
                n += 1
            elif p.is_dir() and p.exists():
                for f in walk_files(p, rel):
                    fp = HOME / f[0]
                    dest = backup_dir / f[0]
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.move(str(fp), str(dest))
                    n += 1
        stats["backed_up"] = n
        return f"{n} files backed up to {backup_dir}" if n else "nothing to back up"

    def step_files():
        count = 0
        step_size = max(1, len(sel_rels) // 300)
        for i, rel in enumerate(sel_rels, 1):
            src = root / "files" / rel
            dest = HOME / rel
            if not src.exists():
                continue
            if dry:
                count += 1
                if i % step_size == 0:
                    emit(events, {"event": "file", "done": i, "total": len(sel_rels),
                                  "name": rel})
                continue
            if src.is_file():
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(str(src), str(dest), follow_symlinks=True)
            else:
                for f in walk_files(src, ""):
                    fp = src / f[0]
                    dp = dest / f[0]
                    dp.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(str(fp), str(dp))
            count += 1
            if i % step_size == 0 or i == len(sel_rels):
                emit(events, {"event": "file", "done": i, "total": len(sel_rels),
                              "name": rel})
        stats["files"] = count
        return f"{count} items restored"

    def log(cmd_out):
        for line in cmd_out.splitlines():
            line = line.strip()
            if line:
                emit(events, {"event": "log", "line": line})

    def step_packages():
        pkgs = manifest.get("packages", [])
        if not pkgs:
            return "none in bundle"
        if "packages" not in sel_cats:
            return "not selected"
        if dry:
            stats["packages"] = len(pkgs)
            return f"would install {len(pkgs)} packages (dry run)"
        try:
            installed = set(run(["pacman", "-Qq"]).stdout.split())
        except FileNotFoundError:
            installed = set()
        missing = [p for p in pkgs if p not in installed]
        if not missing:
            return "all packages already installed"
        avail = set()
        if has("pacman") and missing:
            r = run(["pacman", "-Si", "--"] + missing)
            for line in r.stdout.splitlines():
                if line.startswith("Package "):
                    avail.add(line.split(":", 1)[1].strip())
        installable = [p for p in missing if p in avail]
        notfound = [p for p in missing if p not in avail]
        for chunk in [installable[i:i + 25]
                      for i in range(0, len(installable), 25)]:
            if not chunk:
                continue
            cmd = ["omarchy", "pkg", "add"] + chunk if has("omarchy") \
                else ["pacman", "-S", "--noconfirm", "--needed"] + chunk
            r = run(cmd)
            log(r.stdout)
            if r.returncode != 0:
                log(f"warn: {' '.join(cmd)} failed: {r.stderr.strip()}")
        for p in notfound:
            stats["skipped"].append(f"pkg {p} (not in repos)")
            emit(events, {"event": "log",
                          "line": f"skip {p}: not in repos (AUR or renamed?)"})
        stats["packages"] = len(installable)
        detail = f"{len(installable)} installed"
        if notfound:
            detail += f", {len(notfound)} skipped"
        return detail

    def overlay(base_dir, rels):
        n = 0
        for rel in rels:
            src = root / "files" / rel
            if not src.exists():
                continue
            if src.is_file():
                dest = base_dir / rel[len(HOME.as_posix().rstrip('/') + '/'):] \
                    if rel.startswith(HOME.as_posix()) else base_dir / rel
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(str(src), str(dest), follow_symlinks=True)
            else:
                for f in walk_files(src, ""):
                    fp = src / f[0]
                    dp = base_dir / f[0]
                    dp.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(str(fp), str(dp))
            n += 1
        return n

    def step_plugins():
        plugins = manifest.get("plugins", [])
        if not plugins:
            return "none"
        n = 0
        for p in plugins:
            dest = CFG / "omarchy" / "plugins" / p["id"]
            rels = [f["rel"] for f in manifest["files"]
                    if f["rel"].startswith(f".config/omarchy/plugins/{p['id']}")]
            if dry:
                n += 1
                continue
            if not rels:
                continue
            if p.get("remote"):
                if not dest.exists():
                    r = run(["git", "clone", "--", p["remote"], str(dest)])
                    log(r.stdout.splitlines()[-1] if r.stdout else f"clone {p['id']}")
                    if r.returncode != 0:
                        emit(events, {"event": "log",
                                      "line": f"warn: clone {p['id']} failed: {r.stderr.strip()}"})
            if not dest.exists():
                dest.mkdir(parents=True, exist_ok=True)
            n += overlay(dest, [r.split(f".config/omarchy/plugins/{p['id']}/", 1)[-1]
                                for r in rels])
        stats["plugins"] = n
        return f"{n} plugin files synced"

    def step_themes():
        themes = manifest.get("themes", [])
        if not themes:
            return "none"
        n = 0
        for t in themes:
            dest = CFG / "omarchy" / "themes" / t["name"]
            rels = [f["rel"] for f in manifest["files"]
                    if f["rel"].startswith(f".config/omarchy/themes/{t['name']}")]
            if dry:
                n += 1
                continue
            if not rels:
                continue
            if t.get("remote"):
                if not dest.exists():
                    r = run(["git", "clone", "--", t["remote"], str(dest)])
                    if r.returncode != 0:
                        emit(events, {"event": "log",
                                      "line": f"warn: clone {t['name']} failed: {r.stderr.strip()}"})
            if not dest.exists():
                dest.mkdir(parents=True, exist_ok=True)
            n += overlay(dest, [r.split(f".config/omarchy/themes/{t['name']}/", 1)[-1]
                                for r in rels])
        stats["themes"] = n
        return f"{n} theme files synced"

    def step_defaults():
        d = manifest.get("defaults", {})
        if not d or ("defaults" not in sel_cats and "themes" not in sel_cats):
            return "not selected"
        done = []
        if dry:
            done = [f"would set {k}" for k in d if d.get(k)]
            return "; ".join(done) or "none"
        if d.get("terminal") and "defaults" in sel_cats:
            (CFG).mkdir(parents=True, exist_ok=True)
            (CFG / "xdg-terminals.list").write_text(
                "# Terminal emulator preference order for xdg-terminal-exec\n"
                f"{name_to_desktop(d['terminal'])}\n")
            done.append(f"terminal={d['terminal']}")
        if d.get("browser") and "defaults" in sel_cats:
            mime = CFG / "mimeapps.list"
            text = mime.read_text() if mime.exists() else "[Default Applications]\n"
            did = name_to_desktop(d["browser"])
            for key in ("text/html", "x-scheme-handler/http",
                        "x-scheme-handler/https"):
                pat = re.compile(rf"^{re.escape(key)}=.*$", re.M)
                if pat.search(text):
                    text = pat.sub(f"{key}={did}", text)
                else:
                    text = text.rstrip() + f"\n{key}={did}\n"
            mime.write_text(text)
            done.append(f"browser={d['browser']}")
        if d.get("editor") and "defaults" in sel_cats:
            p = OMSTATE / "defaults" / "editor"
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(d["editor"] + "\n")
            done.append(f"editor={d['editor']}")
        if d.get("agent") and "defaults" in sel_cats:
            p = CFG / "omarchy" / "defaults" / "agent"
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(d["agent"] + "\n")
            done.append(f"agent={d['agent']}")
        theme = d.get("theme")
        if theme and "themes" in sel_cats and has("omarchy"):
            r = run(["omarchy", "theme", "set", theme])
            log(r.stdout or f"theme set {theme}")
            done.append(f"theme={theme}")
            bg = d.get("background")
            if bg:
                bgp = CFG / "omarchy" / bg
                if bgp.exists():
                    run(["omarchy", "theme", "bg", "set", str(bgp)])
                    done.append("background")
        return "; ".join(done)

    def step_restart():
        if dry:
            return "dry run"
        cmds = [["omarchy", "restart", "shell"], ["omarchy", "restart", "hyprctl"]]
        if any(s.startswith(".config/foot") or s.startswith(".config/alacritty")
               or s.startswith(".config/kitty") or s.startswith(".config/ghostty")
               for s in sel_rels):
            cmds.append(["omarchy", "restart", "terminal"])
        out = []
        for c in cmds:
            if not has(c[0]):
                continue
            r = run(c)
            if r.returncode == 0:
                out.append(c[2])
        return f"restarted: {', '.join(out)}" if out else "no restarts needed"

    def step_verify():
        if dry:
            return "dry run"
        ok = missing = 0
        for f in manifest.get("files", []):
            p = HOME / f["rel"]
            if p.exists() and p.stat().st_size == f["bytes"]:
                ok += 1
            else:
                missing += 1
        return f"{ok} verified, {missing} missing"

    apply_step(events, "backup", "Backing up current configs", step_backup)
    apply_step(events, "files", "Restoring files", step_files)
    apply_step(events, "packages", "Installing packages", step_packages)
    apply_step(events, "plugins", "Syncing shell plugins", step_plugins)
    apply_step(events, "themes", "Syncing themes", step_themes)
    apply_step(events, "defaults", "Applying defaults & theme", step_defaults)
    apply_step(events, "restart", "Restarting services", step_restart)
    apply_step(events, "verify", "Verifying", step_verify)

    shutil.rmtree(tmp, ignore_errors=True)
    ok = True
    emit(events, {"event": "done", "ok": ok, "dry_run": dry, "stats": stats,
                  "backup_dir": str(backup_dir)})
    if not args.events:
        print(f"Apply {'(dry run) ' if dry else ''}done: {stats}")
    return 0


