def home_dir_rel(name):
    """Return the on-disk name of a top-level HOME dir, matching
    case-insensitively (so ~/projects matches 'Projects'), or None."""
    try:
        for e in HOME.iterdir():
            if e.is_dir() and e.name.lower() == name.lower():
                return e.name
    except OSError:
        pass
    return None


